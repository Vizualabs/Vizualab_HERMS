{
  "name": "herms",
  "type": "module",
  "private": true,
  "dependencies": {
    "@herms/db": "workspace:*",
    "@herms/shared": "workspace:*"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev:api": "bun --env-file=.env --watch apps/api/src/server.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run build:api && bun run build:notifier && bun run build:web",
    "build:api": "bun run --cwd apps/api build",
    "build:web": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd packages/shared typecheck && bun run --cwd packages/db typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/notifier typecheck && bun run --cwd apps/web typecheck",
    "test": "bun test",
    "db:check": "bun run packages/db/src/check-migrations.ts",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:seed": "bun run packages/db/src/seed.ts",
    "config:phase1": "bun run scripts/configure-phase1-env.ts",
    "verify:phase1": "bun run scripts/verify-phase1.ts",
    "config:phase2": "bun run scripts/configure-phase2-env.ts",
    "verify:phase2": "bun run scripts/verify-phase2.ts",
    "config:phase3": "bun run scripts/configure-phase3-env.ts",
    "verify:phase3": "bun run scripts/verify-phase3.ts",
    "config:phase4": "bun run scripts/configure-phase4-env.ts",
    "verify:phase4": "bun run scripts/verify-phase4.ts",
    "smoke:health": "bun --env-file=.env run hono request apps/api/src/index.ts -P /api/health",
    "ci": "bun run typecheck && bun run test && bun run db:check && bun run build",
    "build:notifier": "bun run --cwd apps/notifier build",
    "config:phase5": "bun run scripts/configure-phase5-env.ts",
    "verify:phase5": "bun run scripts/verify-phase5.ts",
    "verify:phase6": "bun run scripts/verify-phase6.ts",
    "verify:phase7": "bun run scripts/verify-phase7.ts"
  },
  "devDependencies": {
    "@hono/cli": "^0.1.11",
    "@tanstack/cli": "^0.70.2",
    "@tanstack/intent": "^0.3.6",
    "@types/bun": "latest",
    "drizzle-orm": "^0.44.5",
    "typescript": "^6.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "intent": {
    "skills": [
      "@tanstack/cli"
    ],
    "exclude": [
      "@tanstack/cli#add-addons-existing-app",
      "@tanstack/cli#choose-ecosystem-integrations",
      "@tanstack/cli#create-app-scaffold",
      "@tanstack/cli#maintain-custom-addons-dev-watch"
    ]
  }
}
