# Copy this file to .env and replace placeholders locally.
# Never commit .env or paste credentials into source files.
DATABASE_URL=postgresql://runtime_user:password@runtime-host.example/neondb?sslmode=require
MIGRATION_DATABASE_URL=postgresql://migration_user:password@migration-host.example/neondb?sslmode=require
APP_ENV=development
PORT=3001
API_PROXY_TARGET=http://localhost:3001
AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
SEED_USER_PASSWORD=set-a-unique-local-password-with-at-least-12-characters
SEED_STORE_NAME=HERMS Main Store
SEED_STORE_ADDRESS=
